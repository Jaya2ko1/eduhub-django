# EduHub environment variables
#
# This file only documents the variables that eduhub/settings.py reads.
# It is NOT loaded automatically. Set the variables in your shell or on your
# hosting platform. Never put real secrets in this file or commit a .env file.

# Turns Django debug mode on or off.
# Accepted values: 1, true, yes, on / 0, false, no, off. Missing means off.
# Local development: set to True. Production: leave unset or set to False.
DJANGO_DEBUG=False

# Secret used to sign sessions, password-reset links and CSRF tokens.
# Required when DJANGO_DEBUG is off. When DJANGO_DEBUG is on and this is
# missing, an insecure local-development key is used instead.
# Generate a value on the server with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=replace-with-a-generated-secret-key

# Comma-separated host names the site is served from (production only).
# With DJANGO_DEBUG on and this empty, localhost and 127.0.0.1 are allowed.
DJANGO_ALLOWED_HOSTS=eduhub.example.com,www.eduhub.example.com

# Extra origins allowed to submit forms, with scheme (only needed behind some proxies
# or when posting from another subdomain), for example: https://eduhub.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=

# HTTPS settings. Redirects and secure cookies are ON by default when DJANGO_DEBUG is
# off; set any of these to False only if the site is genuinely served over plain HTTP.
DJANGO_SECURE_SSL_REDIRECT=True
DJANGO_SESSION_COOKIE_SECURE=True
DJANGO_CSRF_COOKIE_SECURE=True
# Set to True when a proxy in front of Django handles HTTPS and sends X-Forwarded-Proto
# (Render, Railway, Heroku, nginx...). Without it, the HTTPS redirect can loop.
DJANGO_SECURE_PROXY_SSL_HEADER=False

# HTTP Strict Transport Security, in seconds. Browsers remember it, so enable it only
# once HTTPS works: try 3600 first, then 31536000 (one year). 0 means off.
DJANGO_SECURE_HSTS_SECONDS=0
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=False

# Log level for the console: DEBUG, INFO, WARNING, ERROR. Defaults to INFO with
# DJANGO_DEBUG on and WARNING with it off. Server errors are always logged.
DJANGO_LOG_LEVEL=WARNING
