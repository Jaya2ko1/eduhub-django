# EduHub environment variables
#
# This file only documents the variables that eduhub/settings.py reads.
# It is NOT loaded automatically. Set the variables in your shell or on your
# hosting platform. Never put real secrets in this file or commit a .env file.

# Turns Django debug mode on or off.
# Accepted values: 1, true, yes, on / 0, false, no, off. Missing means off.
# Local development: set to True. Production: leave unset or set to False.
DJANGO_DEBUG=False

# Secret used to sign sessions, password-reset links and CSRF tokens.
# Required when DJANGO_DEBUG is off. When DJANGO_DEBUG is on and this is
# missing, an insecure local-development key is used instead.
# Generate a value on the server with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=replace-with-a-generated-secret-key

# Comma-separated host names the site is served from (production only).
# With DJANGO_DEBUG on and this empty, localhost and 127.0.0.1 are allowed.
DJANGO_ALLOWED_HOSTS=eduhub.example.com,www.eduhub.example.com
